#include <windows.h>

1 ICON "TrueCrimeNYC.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,9,2,0
 PRODUCTVERSION 0,9,2,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "True Crime NYC Xbox Port contributors"
            VALUE "FileDescription", "True Crime: New York City - Xbox recomp"
            VALUE "FileVersion", "0.9.2.0"
            VALUE "InternalName", "TrueCrimeNYC"
            VALUE "OriginalFilename", "TrueCrimeNYC.exe"
            VALUE "ProductName", "True Crime: New York City"
            VALUE "ProductVersion", "0.9.2.0"
            VALUE "Comments", "Unofficial native port. Requires the user's own game files."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
