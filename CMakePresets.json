{
    "version": 6,
    "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_RC_COMPILER": "llvm-rc",
                "CMAKE_C_FLAGS": "-march=x86-64-v2",
                "CMAKE_CXX_FLAGS": "-march=x86-64-v2"
            },
            "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}
        },
        {"name": "debug", "displayName": "Debug", "inherits": "base",
         "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
        {"name": "tests", "displayName": "Host tests only", "inherits": "base",
         "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "TCNYC_TESTS_ONLY": "ON"}},
        {"name": "release", "displayName": "Release", "inherits": "base",
         "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
        {"name": "relwithdebinfo", "displayName": "RelWithDebInfo", "inherits": "base",
         "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}},
        {"name": "dev", "displayName": "Dev (debug tools)", "inherits": "base",
         "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "TCNYC_DEV_TOOLS": "ON"}},
        {"name": "pal", "displayName": "PAL (European XBE)", "inherits": "base",
         "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "TCNYC_PAL": "ON"}},
        {"name": "pal-eu", "displayName": "PAL (second European disc)", "inherits": "base",
         "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "TCNYC_PAL_EU": "ON"}},
        {"name": "pal-dev", "displayName": "PAL Dev (debug tools)", "inherits": "base",
         "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "TCNYC_PAL": "ON", "TCNYC_DEV_TOOLS": "ON"}},
        {"name": "pal-eu-dev", "displayName": "PAL EU Dev (debug tools)", "inherits": "base",
         "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "TCNYC_PAL_EU": "ON", "TCNYC_DEV_TOOLS": "ON"}}
    ],
    "buildPresets": [
        {"name": "debug", "configurePreset": "debug"},
        {"name": "tests", "configurePreset": "tests"},
        {"name": "release", "configurePreset": "release"},
        {"name": "relwithdebinfo", "configurePreset": "relwithdebinfo"},
        {"name": "dev", "configurePreset": "dev"},
        {"name": "pal", "configurePreset": "pal"},
        {"name": "pal-eu", "configurePreset": "pal-eu"},
        {"name": "pal-dev", "configurePreset": "pal-dev"},
        {"name": "pal-eu-dev", "configurePreset": "pal-eu-dev"}
    ]
}
