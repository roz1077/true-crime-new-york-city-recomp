+void ShowPointer(bool show) {
+    if (show == !g_cursor_hidden) return;
+    if (show) {
+        while (ShowCursor(TRUE) < 0) {
+        }
+        SetCursor(LoadCursorW(nullptr, IDC_ARROW));
+    } else {
+        while (ShowCursor(FALSE) >= 0) {
+        }
