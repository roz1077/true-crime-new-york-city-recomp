+inline constexpr GridSite kGridSites[] = {
+    {0x00138BCD, "ecx", 1},
+    {0x00138BE4, "edi", 1},
+    {0x0013F212, "ecx", 1},
+    {0x0013F229, "edi", 1},
+    {0x00146D30, "esi", 3},
+    {0x00146D7D, "ecx", 3},
+    {0x00147053, "esi", 2},
+    {0x0014709D, "ecx", 2},
+    {0x00147373, "edi", 2},
+    {0x001473BD, "ecx", 2},
+    {0x0014A5D1, "ecx", 1},
