+        {"....#....", "...###...", "...#.#...", "..##.##..", "..#...#..", ".##...##.", ".#.....#.", "#########", "#########"},
+        {"..#####..", ".##...##.", "##.....##", "#.......#", "#.......#", "#.......#", "##.....##", ".##...##.", "..#####.."},
+        {"#########", "#########", "##.....##", "##.....##", "##.....##", "##.....##", "##.....##", "#########", "#########"},
+    };
+    constexpr uint8_t ink[][3] = {{255, 195, 162}, {183, 243, 125}, {157, 161, 255}, {255, 176, 240}};
+    if (style == input::PromptStyle::PlayStation) {
+        for (int i = 0; i < 4; ++i) {
+            for (int y = 234; y <= 247; ++y) {
+                for (int x = -7; x <= 7; ++x) {
+                    auto* p = pixel(centers[i] + x, y);
