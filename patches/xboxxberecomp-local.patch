+constexpr DXGI_FORMAT kSmaaWeights = DXGI_FORMAT_R8G8B8A8_UNORM;
+constexpr DXGI_FORMAT kSmaaArea = DXGI_FORMAT_R8G8_UNORM;
+constexpr DXGI_FORMAT kSmaaSearch = DXGI_FORMAT_R8_UNORM;
