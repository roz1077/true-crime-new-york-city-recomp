+    constexpr const char* letters[][7] = {
+        {"#..", "#..", "#..", "#..", "#..", "#..", "###"},
+        {"##.", "#.#", "#.#", "##.", "#.#", "#.#", "#.#"},
+    };
+    constexpr const char* suffixes[][7] = {
+        {".#.", "##.", ".#.", ".#.", ".#.", ".#.", "###"},
+        {"###", "..#", "..#", "###", "#..", "#..", "###"},
+        {"##.", "#.#", "#.#", "##.", "#.#", "#.#", "##."},
+        {"###", ".#.", ".#.", ".#.", ".#.", ".#.", ".#."},
