+            return result;
+        }
+        const bool wrote = std::fwrite(change.text.data(), 1, change.text.size(), out) == change.text.size();
+        const bool closed = std::fclose(out) == 0;
+        if (!wrote || !closed) {
+            result.error = "write failed for " + change.temp.string();
+            return result;
+        }
+    }
