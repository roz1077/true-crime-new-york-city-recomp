if(BUILD_TESTING)
    find_package(Python3 QUIET COMPONENTS Interpreter)
    if(Python3_Interpreter_FOUND)
        set(fixture_tools "${CMAKE_CURRENT_BINARY_DIR}/updater-fixture-tools")
        add_library(tcnyc_updater_fixture_core STATIC "${TCNYC_REPO}/launcher/updater.cpp")
        target_compile_definitions(tcnyc_updater_fixture_core PRIVATE "TCNYC_UPDATER_TEST_TOOLS=\"${fixture_tools}\"" "TCNYC_VERSION=\"1.0.1\"" TCNYC_PAL_SHA1=1 TCNYC_PAL_EU_SHA1=1)
        target_link_libraries(tcnyc_updater_fixture_core PUBLIC ${TCNYC_TEST_SDL})
        target_include_directories(tcnyc_updater_fixture_core PUBLIC "${TCNYC_REPO}/launcher" PRIVATE "${TCNYC_REPO}/sdk/runtime")
        foreach(version old new)
            add_executable(tcnyc_updater_fixture_${version} "${TCNYC_REPO}/tests/updater_fixture.cpp")
            target_compile_definitions(tcnyc_updater_fixture_${version} PRIVATE "TCNYC_FIXTURE_VERSION=\"${version}\"")
            target_link_libraries(tcnyc_updater_fixture_${version} PRIVATE tcnyc_updater_fixture_core)
        endforeach()
        set(mock_arguments)
        if(WIN32)
            add_executable(tcnyc_mock_curl "${TCNYC_REPO}/tests/updater_mock_curl.cpp")
            target_compile_definitions(tcnyc_mock_curl PRIVATE _CRT_SECURE_NO_WARNINGS)
            if(MINGW)
                target_link_options(tcnyc_mock_curl PRIVATE -municode)
            endif()
            list(APPEND mock_arguments $<TARGET_FILE:tcnyc_mock_curl>)
        endif()
        add_test(NAME updater_integration
            COMMAND "${Python3_EXECUTABLE}" "${TCNYC_REPO}/tests/updater_integration.py"
                $<TARGET_FILE:tcnyc_updater_fixture_old> $<TARGET_FILE:tcnyc_updater_fixture_new> "${fixture_tools}" ${mock_arguments})
        set_tests_properties(updater_integration PROPERTIES TIMEOUT 60)
    endif()
endif()
